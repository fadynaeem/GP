# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# Required API Keys (MUST be set)
AUDIO_API_KEY=your_audio_api_key_here
API_KEY=your_main_api_key_here

# Optional API Keys
HF_TOKEN=your_huggingface_token_here

# Model Configuration (optional - defaults provided)
ARABIC_MODEL_NAME=pourmand1376/arabic-quran-nahj-sahife
WHISPER_MODEL_NAME=haddin

# Flask Configuration (optional - defaults provided)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# Audio Configuration (optional - defaults provided)
AUDIO_TARGET_SR=22050
AUDIO_DURATION=30
EMBEDDING_SIZE=512
MAX_LENGTH=512

# Threshold Configuration (optional - defaults provided)
AUDIO_MATCH_THRESHOLD=0.7
TEXT_MATCH_THRESHOLD=0.85

# Vector Database Configuration (optional - defaults provided)
VECTOR_DB_NAMESPACE=ns1
VECTOR_DB_K=1
